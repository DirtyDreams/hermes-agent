# Database
DATABASE_URL=postgresql://velvet:velvet@localhost:5432/velvet

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production-min-32-chars
REFRESH_TOKEN_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=30d

# Email HMAC
EMAIL_HMAC_SECRET=change-me-in-production-min-32-chars

# Location fuzzing
LOCATION_FUZZ_MILES=25

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Resend
RESEND_API_KEY=

# Storage (MinIO dev / R2 prod)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=velvet-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/velvet-media

# App
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
